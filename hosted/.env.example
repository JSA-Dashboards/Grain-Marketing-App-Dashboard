# Copy to .env on the server and fill in. Never commit the real .env.

# The web address people use (DNS must point at this server)
SITE_ADDRESS=grain.example.com
PUBLIC_URL=https://grain.example.com

# Sign-in emails (any SMTP server: JSA's Microsoft 365, or a sending service). Leave SMTP_HOST
# empty to print sign-in links to `docker compose logs app` instead (testing only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Grain Marketing Desk <no-reply@example.com>

# Contract scanning and Intel drafts (Claude API key from console.anthropic.com, billed to JSA)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Nightly jobs: a read-only Snowflake service user with a key pair.
# Put its private key at hosted/secrets/snowflake_key.p8 (not committed).
SNOWFLAKE_ACCOUNT=JSA-ANALYTICS
SNOWFLAKE_USER=GRAIN_DESK_SVC
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
TIMEZONE=America/Chicago
