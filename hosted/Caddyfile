# HTTPS for the app. SITE_ADDRESS (in .env) is the web address, e.g. grain.example.com;
# Caddy gets and renews the certificate automatically once that name points at this server.
{$SITE_ADDRESS} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	reverse_proxy app:8000
}
